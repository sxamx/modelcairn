{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelCairn administrative settings v1alpha1 (draft)",
  "description": "Structural contract. Decode safely, resolve omissions against defaults/current settings, then perform semantic validation described in admin-settings-v1.md. Defaults are annotations, not mutations.",
  "$ref": "#/$defs/document",
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "spec"],
      "properties": {
        "apiVersion": { "const": "modelcairn.io/v1alpha1" },
        "kind": { "const": "AdminSettings" },
        "resourceVersion": { "type": "integer", "minimum": 1 },
        "spec": { "$ref": "#/$defs/spec" }
      }
    },
    "initial": {
      "allOf": [
        { "$ref": "#/$defs/document" },
        { "not": { "required": ["resourceVersion"] }, "properties": { "spec": { "required": ["publicOrigin"] } } }
      ]
    },
    "update": {
      "allOf": [ { "$ref": "#/$defs/document" }, { "required": ["resourceVersion"] } ]
    },
    "resolved": {
      "allOf": [
        { "$ref": "#/$defs/update" },
        { "properties": { "spec": { "required": ["publicOrigin", "listen", "transport", "trustedProxyCidrs", "tlsCertificatePath", "tlsPrivateKeyPath", "idleSeconds", "absoluteSeconds", "globalAttemptsPerMinute", "globalBurst", "clientAttemptsPerMinute", "clientBurst", "maxClientEntries", "clientIdleSeconds", "argonMemoryKiB", "argonIterations"] } } }
      ]
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publicOrigin": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "listen": { "type": "string", "minLength": 1, "maxLength": 128, "default": "127.0.0.1:8080" },
        "transport": { "enum": ["loopback-http", "direct-tls", "proxy-tls"], "default": "loopback-http" },
        "trustedProxyCidrs": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 }, "default": [] },
        "tlsCertificatePath": { "type": "string", "maxLength": 4096, "default": "" },
        "tlsPrivateKeyPath": { "type": "string", "maxLength": 4096, "default": "" },
        "idleSeconds": { "type": "integer", "minimum": 300, "maximum": 86400, "default": 1800 },
        "absoluteSeconds": { "type": "integer", "minimum": 300, "maximum": 604800, "default": 43200 },
        "globalAttemptsPerMinute": { "type": "integer", "minimum": 1, "maximum": 120, "default": 30 },
        "globalBurst": { "type": "integer", "minimum": 1, "maximum": 20, "default": 5 },
        "clientAttemptsPerMinute": { "type": "integer", "minimum": 1, "maximum": 30, "default": 5 },
        "clientBurst": { "type": "integer", "minimum": 1, "maximum": 10, "default": 3 },
        "maxClientEntries": { "type": "integer", "minimum": 64, "maximum": 4096, "default": 1024 },
        "clientIdleSeconds": { "type": "integer", "minimum": 60, "maximum": 3600, "default": 900 },
        "argonMemoryKiB": { "type": "integer", "minimum": 19456, "maximum": 65536, "default": 19456 },
        "argonIterations": { "type": "integer", "minimum": 2, "maximum": 6, "default": 2 }
      }
    }
  }
}
