{
  "apiVersion": "modelcairn.io/v1alpha1",
  "kind": "Configuration",
  "resources": [
    {"kind":"Provider","state":"present","metadata":{"name":"onboarding","displayName":"Example Provider"},"spec":{}},
    {"kind":"ProviderAccount","state":"present","metadata":{"name":"onboarding-account"},"spec":{"providerRef":{"name":"onboarding"}}},
    {"kind":"ProviderConnection","state":"present","metadata":{"name":"onboarding-api"},"spec":{"providerRef":{"name":"onboarding"},"baseUrl":"https://api.example.invalid/v1","adapter":"openai-chat-v1","allowPrivateNetwork":false,"enabled":true}},
    {"kind":"Egress","state":"present","metadata":{"name":"onboarding-direct"},"spec":{"type":"direct","enabled":true}},
    {"kind":"Credential","state":"present","metadata":{"name":"onboarding-key"},"spec":{"providerAccountRef":{"name":"onboarding-account"},"egressRef":{"name":"onboarding-direct"},"secretRef":{"name":"onboarding-secret"},"enabled":true}},
    {"kind":"Model","state":"present","metadata":{"name":"onboarding-model"},"spec":{"connectionRef":{"name":"onboarding-api"},"providerModelId":"example-chat-model","capabilities":["text","stream","tools"],"enabled":true}},
    {"kind":"Destination","state":"present","metadata":{"name":"onboarding-primary"},"spec":{"modelRef":{"name":"onboarding-model"},"credentialRef":{"name":"onboarding-key"},"enabled":true,"weight":100}},
    {"kind":"Strategy","state":"present","metadata":{"name":"onboarding-sequential"},"spec":{"destinations":[{"name":"onboarding-primary"}],"maxAttempts":1,"attemptTimeoutMs":60000,"totalTimeoutMs":120000}},
    {"kind":"Route","state":"present","metadata":{"name":"onboarding-route"},"spec":{"modelAlias":"assistant","strategyRef":{"name":"onboarding-sequential"},"enabled":true}},
    {"kind":"AgentToken","state":"present","metadata":{"name":"onboarding-agent"},"spec":{"allowedRouteRefs":[{"name":"onboarding-route"}],"expiresAt":null,"enabled":true}}
  ]
}
